{
  "name": "@opensuperlab/coderelay",
  "version": "0.2.1",
  "description": "Install it and GitHub Copilot works as an orchestrator: every request becomes goal → plan → your approval → specialist agents implement → tests verify (auto-retry up to 5x). Long-running session memory plus cost and risk reports. No MCP, no config.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "coderelay": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "postinstall": "node scripts/postinstall.cjs",
    "prepublishOnly": "npm run clean && npm test"
  },
  "keywords": [
    "github-copilot",
    "copilot",
    "copilot-agents",
    "custom-agents",
    "subagents",
    "orchestrator",
    "multi-agent",
    "ai-agents",
    "agentic-workflow",
    "long-running",
    "session-memory",
    "cost-tracking",
    "premium-requests",
    "risk-analysis",
    "guardrails",
    "ai-safety",
    "vscode",
    "cli"
  ],
  "author": "Vamsi Krishna",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vamsikrishna787/CodeRelay.git"
  },
  "bugs": {
    "url": "https://github.com/vamsikrishna787/CodeRelay/issues"
  },
  "homepage": "https://github.com/vamsikrishna787/CodeRelay#readme",
  "engines": {
    "node": ">=20.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
